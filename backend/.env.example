# Copy to .env. Provider: auto | cloud | openai_compatible | mock
#   auto = openai_compatible if ARENA_OPENAI_BASE_URL + ARENA_OPENAI_API_KEY are set,
#          else cloud if any of OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY is set,
#          else mock (deterministic, offline).
ARENA_PROVIDER=auto

# Hosted models (provider=cloud). One assistant and one subject candidate per model; the vendor is inferred
# from the id: gpt-* -> OpenAI, claude-* -> Anthropic, gemini-* -> Google Gemini.
ARENA_MODELS=gpt-6-luna,claude-haiku-5-5,gemini-3.5-flash-lite
ARENA_SUBJECT_MODELS=
ARENA_GRADER_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# OpenAI-compatible gateway (provider=openai_compatible), e.g. the challenge-provided gpt-oss-20b endpoint
# or a local Ollama server: http://localhost:11434/v1 with any non-empty key
ARENA_OPENAI_BASE_URL=
ARENA_OPENAI_API_KEY=
ARENA_OPENAI_MODEL=gpt-oss-20b
# Optional: several gateway models, e.g. ARENA_OPENAI_ASSISTANT_MODELS=gpt-oss:20b,llama3.1:8b,mistral-nemo:12b
ARENA_OPENAI_ASSISTANT_MODELS=
ARENA_OPENAI_SUBJECT_MODELS=
ARENA_OPENAI_GRADER_MODEL=
ARENA_OPENAI_TEMPERATURE=0.3

# Login: the trainer account seeded on first start (investigators can also register themselves in the app).
ARENA_ADMIN_USER=trainer
ARENA_ADMIN_PASSWORD=arena-demo
# ARENA_SECRET_KEY=            # token signing key; generated into data/secret.key when unset
# ARENA_AUTH_REQUIRED=true

# Throughput: requests per minute per vendor (0 = no client-side limit; the Gemini free tier allows 15/min),
# concurrent bake-off trials, and the on-disk response cache (data/llm_cache.sqlite).
ARENA_OPENAI_RPM=0
ARENA_ANTHROPIC_RPM=0
ARENA_GOOGLE_RPM=14
ARENA_BAKEOFF_WORKERS=4
ARENA_LLM_CACHE=true

# Optional Neo4j evidence graph (docker-compose.neo4j.yml, Neo4j Desktop, or a free Aura instance). Unset = off.
ARENA_NEO4J_URI=
ARENA_NEO4J_USER=neo4j
ARENA_NEO4J_PASSWORD=
ARENA_NEO4J_DATABASE=neo4j

ARENA_DATA_DIR=./data
