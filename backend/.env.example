# Copy to .env. Provider: auto | openai_compatible | anthropic | mock
#   auto = openai_compatible if ARENA_OPENAI_BASE_URL + ARENA_OPENAI_API_KEY are set,
#          else anthropic if ANTHROPIC_API_KEY is set, else mock (deterministic, offline).
ARENA_PROVIDER=auto

# OpenAI-compatible endpoint (e.g. the challenge-provided gpt-oss-20b gateway)
ARENA_OPENAI_BASE_URL=
ARENA_OPENAI_API_KEY=
ARENA_OPENAI_MODEL=gpt-oss-20b

# Anthropic (used when provider=anthropic)
ANTHROPIC_API_KEY=
ARENA_ASSISTANT_MODEL=claude-opus-5-5
ARENA_SUBJECT_MODEL=claude-opus-5-5
ARENA_GRADER_MODEL=claude-sonnet-5-5

ARENA_DATA_DIR=./data
